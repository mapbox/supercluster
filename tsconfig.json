{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2022"],
        "noEmit": true,
        "strict": true,
        "skipLibCheck": true,
        "allowImportingTsExtensions": true,
        "isolatedModules": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": ["index.d.ts", "types.ts"]
}
